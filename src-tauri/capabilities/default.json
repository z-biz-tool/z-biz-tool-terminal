{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口能力：原生对话框 + 剪贴板写入 + 核心事件/路径。文件读写一律走后端带白名单校验的命令，WebView 不再直接持有 fs/shell 能力。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text"
  ]
}
